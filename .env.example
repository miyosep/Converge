# Server only. Never prefix credentials or private keys with NEXT_PUBLIC_.
KILN_API_KEY=
KILN_BASE_URL=https://api.bricksum.com/v1
KILN_MODEL=qwen3-32b
DATABASE_URL=
DATABASE_URL_UNPOOLED=
NEON_BRANCH=
SESSION_SECRET=
APP_ORIGIN=
CHAIN_ID=11155111
RPC_URL=
GROUP_WALLET_ADDRESS=
MOCK_USDC_ADDRESS=
AGENT_EXECUTOR_PRIVATE_KEY=
CHAIN_CONFIRMATIONS=
DEMO_MODE=false
KILN_MOCK_MODE=false

# Wallet-connected Explore Demo. Web app and local worker share this private directory.
EXPLORE_DEMO_ENABLED=false
EXPLORE_DEMO_DIRECTORY=.demo
EXPLORE_DEMO_ACCESS_CODE=
EXPLORE_DEMO_MAX_RUNS=7
# Lifetime upper bound on signed worker transaction costs, including ETH grants.
EXPLORE_DEMO_MAX_ETH=0.06

# Deployment/demo scripts only. Do not provision these in the web runtime.
DEPLOYER_PRIVATE_KEY=
DEMO_PARTICIPANT_1_PRIVATE_KEY=
