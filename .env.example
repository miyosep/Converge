# Server only. Never prefix credentials or private keys with NEXT_PUBLIC_.
KILN_API_KEY=
KILN_BASE_URL=https://api.bricksum.com/v1
KILN_MODEL=qwen3-32b
DATABASE_URL=
DATABASE_URL_UNPOOLED=
NEON_BRANCH=
SESSION_SECRET=
APP_ORIGIN=
CHAIN_ID=11155111
RPC_URL=
GROUP_WALLET_ADDRESS=
MOCK_USDC_ADDRESS=
AGENT_EXECUTOR_PRIVATE_KEY=
GROUP_EXECUTION_ENABLED=false
# Lifetime upper bound on ordinary-group executor gas, reserved before broadcast.
GROUP_EXECUTION_MAX_ETH=0.01
CHAIN_CONFIRMATIONS=
DEMO_MODE=false
KILN_MOCK_MODE=false

# Vercel: choose inngest or hybrid. Enable jobs only in the intended deployment.
# Inngest keys below are not needed for hybrid. Use a separate DB for previews.
# local: file workers; inngest: hosted jobs; hybrid: Vercel + a running PC.
BACKGROUND_DRIVER=local
BACKGROUND_JOBS_ENABLED=false
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
# Local development only; never set true in a hosted deployment.
INNGEST_DEV=false

# Optional Google Calendar. Same values in web server and calendar worker.
# Redirect URI: APP_ORIGIN + /api/calendar/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 32 random bytes encoded as 64 hexadecimal characters. Keep stable and secret.
GOOGLE_TOKEN_ENCRYPTION_KEY=

# Explore Demo. Directory is used only by local mode and the import tool.
EXPLORE_DEMO_ENABLED=false
EXPLORE_DEMO_DIRECTORY=.demo
EXPLORE_DEMO_ACCESS_CODE=
EXPLORE_DEMO_MAX_RUNS=8
# Lifetime upper bound on signed worker transaction costs, including ETH grants.
EXPLORE_DEMO_MAX_ETH=0.06

# Private signing credentials: local scripts or the hosted Inngest job endpoint.
# Never expose as NEXT_PUBLIC_ variables or provision signing keys in previews.
DEPLOYER_PRIVATE_KEY=
DEMO_PARTICIPANT_1_PRIVATE_KEY=
DEMO_PARTICIPANT_2_PRIVATE_KEY=
DEMO_PARTICIPANT_3_PRIVATE_KEY=
DEMO_PARTICIPANT_4_PRIVATE_KEY=
DEMO_PARTICIPANT_5_PRIVATE_KEY=
DEMO_PARTICIPANT_6_PRIVATE_KEY=
DEMO_MERCHANT_A_PRIVATE_KEY=
DEMO_MERCHANT_B_PRIVATE_KEY=
DEMO_MERCHANT_C_PRIVATE_KEY=
DEMO_MERCHANT_D_PRIVATE_KEY=
DEMO_MERCHANT_E_PRIVATE_KEY=
