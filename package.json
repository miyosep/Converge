{
  "name": "converge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24.19.0 <25",
    "pnpm": "11.19.0"
  },
  "scripts": {
    "hybrid:start": "node --import tsx scripts/hybrid-service.ts",
    "hybrid:check": "node --import tsx scripts/hybrid-service.ts --check",
    "hybrid:install": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-hybrid-task.ps1",
    "demo:groups-verify": "node --env-file=.env --import tsx scripts/verify-group-acceptance.ts",
    "demo:groups-server": "node --import tsx scripts/group-acceptance-server.ts",
    "demo:groups-acceptance": "node --env-file=.env --env-file=.env.development --import tsx scripts/group-acceptance.ts",
    "groups:worker": "node --env-file=.env --env-file=.env.development --import tsx scripts/group-execution-worker.ts",
    "groups:worker-check": "node --env-file=.env --env-file=.env.development --import tsx scripts/group-execution-worker.ts --check",
    "demo:group-chain-test": "node --import tsx scripts/group-chain-rehearsal.ts",
    "demo:explore": "node --env-file=.env --env-file=.env.development --import tsx scripts/explore-demo-worker.ts",
    "demo:explore-check": "node --env-file=.env --env-file=.env.development --import tsx scripts/explore-demo-worker.ts --check",
    "demo:explore-prepare": "node --env-file=.env --env-file=.env.development --import tsx scripts/prepare-explore-bots.ts",
    "demo:explore-test": "node --import tsx scripts/explore-local-rehearsal.ts",
    "demo:explore-live": "node --env-file=.env --env-file=.env.development --import tsx scripts/explore-live-rehearsal.ts",
    "demo:explore-verify": "node --env-file=.env --import tsx scripts/explore-verify-evidence.ts",
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "kiln:check": "node --env-file=.env --import tsx scripts/check-kiln.ts",
    "demo:decision": "node --import tsx scripts/demo-decision.ts",
    "db:migrate:dev": "node --env-file=.env.development --import tsx scripts/db-migrate.ts dev-preferences",
    "db:rehearse:dev": "node --env-file=.env.development --import tsx scripts/db-preference-rehearsal.ts",
    "db:auth-rehearse:dev": "node --env-file=.env.development --import tsx scripts/db-auth-rehearsal.ts",
    "db:group-execution-rehearse:dev": "node --env-file=.env.development --import tsx scripts/group-execution-db-rehearsal.ts",
    "http:rehearse:dev": "node --import tsx scripts/http-rehearsal.ts",
    "http:kiln-rehearse:dev": "node --env-file=.env.development --import tsx scripts/http-rehearsal.ts --kiln",
    "contracts:build": "forge build --root contracts",
    "contracts:test": "forge test --root contracts -vv",
    "contracts:abi": "node --import tsx scripts/export-abi.ts",
    "deploy:sepolia": "node --env-file=.env --import tsx scripts/deploy-sepolia.ts",
    "mint:mock": "node --env-file=.env --import tsx scripts/mint-mock-usdc.ts",
    "demo:wallets": "node --import tsx scripts/create-demo-wallets.ts",
    "demo:roles": "node --import tsx scripts/create-demo-roles.ts",
    "demo:fund-executor": "node --env-file=.env --import tsx scripts/fund-demo-executor.ts",
    "demo:preflight": "node --env-file=.env --import tsx scripts/demo-preflight.ts",
    "demo:chain": "node --env-file=.env --import tsx scripts/demo-chain-baseline.ts",
    "demo:gas-topup": "node --env-file=.env --import tsx scripts/top-up-demo-gas.ts",
    "demo:fund": "node --env-file=.env --import tsx scripts/fund-demo-wallets.ts",
    "format": "prettier --write app src tests scripts package.json tsconfig.json next.config.ts .github",
    "format:check": "prettier --check app src tests scripts package.json tsconfig.json next.config.ts .github",
    "check": "tsc --noEmit && prettier --check app src tests scripts package.json tsconfig.json next.config.ts .github && tsx --test tests/*.test.ts",
    "calendar:worker": "node --env-file=.env --env-file=.env.development --import tsx scripts/calendar-worker.ts",
    "calendar:check": "node --env-file=.env --env-file=.env.development --import tsx scripts/calendar-worker.ts --check"
  },
  "dependencies": {
    "@neon/config": "1.8.2",
    "@neon/env": "1.4.7",
    "@vercel/functions": "3.9.9",
    "inngest": "4.21.0",
    "lucide-react": "1.48.0",
    "next": "16.3.6",
    "pg": "8.23.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "viem": "2.56.9",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@openzeppelin/contracts": "5.4.0",
    "@types/node": "24.19.0",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
